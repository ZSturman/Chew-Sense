<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Merged with the generated Info.plist. Arrays cannot be expressed as
	     INFOPLIST_KEY_ build settings, so Bonjour discovery lives here. -->
	<!-- Lets iOS resume sending queued recordings to the Mac while the app is
	     closed (CollectServices.backgroundSyncTask). No entitlement involved. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.chewsense.collect.sync</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_chewsense._tcp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.chewsense.collect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>chewsense-collect</string>
			</array>
		</dict>
	</array>
	<!-- Companion apps this app may open (Chew Sense links only navigate). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>chewsense-live</string>
	</array>
</dict>
</plist>
