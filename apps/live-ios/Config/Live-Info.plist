<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Arrays cannot be expressed as
	     INFOPLIST_KEY_ build settings, so Bonjour discovery of the Mac's
	     loop service (read-only status) lives here, as in Collect. -->
