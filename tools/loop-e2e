#!/usr/bin/env bash
# End-to-end check of Collect's transfer code against an isolated Mac loop
# service: pairing, finding the Mac after an address change, an unreachable
# Mac, two queued recordings, processing, and a duplicate send; with Home
# Services available, also the home-server mailbox (Mac asleep, Pi outages,
# interrupted deposits and direct transfers, collection on wake).
# Synthetic recordings in a temporary folder only; the running service,
# workspace/ and the wearer's pairings are not touched.
#
#   tools/loop-e2e [simulator-udid]
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PYTHON="${CHEWSENSE_PYTHON:-$ROOT/.venv/bin/python}"
SIMULATOR="${1:-$(xcrun simctl list devices available | awk -F '[()]' '/iPhone 17 Pro \(/ {print $2; exit}')}"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/chewsense-loop-e2e.XXXXXX")"
RESULT="$ROOT/build/LoopE2E-Collect.xcresult"
HARNESS=
trap 'if [[ -n "$HARNESS" ]]; then kill "$HARNESS" 2>/dev/null || true; fi; chmod -R u+w "$SCRATCH" 2>/dev/null; rm -rf "$SCRATCH"' EXIT

export PYTHONPATH="$ROOT/pipelines/vision:$ROOT/pipelines/motion${PYTHONPATH:+:$PYTHONPATH}"
# With a Home Services checkout, the home-server mailbox is tested too (isolated
# fixture, never the Pi). HOME_SERVICES_SRC may point at a worktree.
HS="${HOME_SERVICES:-$HOME/Workspace/Projects/Home Services}"
if [[ -x "$HS/.venv/bin/python" && -z "${CHEWSENSE_E2E_NO_HOME:-}" ]]; then
  export HOME_SERVICES_PYTHON="$HS/.venv/bin/python"
  export HOME_SERVICES_SRC="${HOME_SERVICES_SRC:-$HS/src}"
fi
"$PYTHON" "$ROOT/pipelines/vision/tests/loop_e2e_harness.py" "$SCRATCH" > "$SCRATCH/harness.log" 2>&1 &
HARNESS=$!
for _ in $(seq 1 100); do [[ -f "$SCRATCH/fixture.json" ]] && break; sleep 0.2; done
[[ -f "$SCRATCH/fixture.json" ]] || { cat "$SCRATCH/harness.log"; exit 1; }

rm -rf "$RESULT"
TEST_RUNNER_CHEWSENSE_LOOP_FIXTURE="$SCRATCH/fixture.json" xcodebuild test \
  -project "$ROOT/apps/collect-ios/ChewSenseCollect.xcodeproj" -scheme ChewSenseCollect \
  -destination "platform=iOS Simulator,id=$SIMULATOR" \
  -derivedDataPath "$ROOT/build/DerivedData-ios" -resultBundlePath "$RESULT" \
  -only-testing:ChewSenseCollectTests/LoopEndToEndTests -parallel-testing-enabled NO -quiet
touch "$SCRATCH/done"
wait "$HARNESS" && status=0 || status=$?
tail -1 "$SCRATCH/harness.log"
exit "$status"
