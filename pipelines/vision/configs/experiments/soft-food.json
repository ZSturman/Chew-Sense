{
  "schema_version": "guided-experiment/1",
  "experiment_id": "soft-food",
  "version": 1,
  "title": "Soft Food",
  "summary": "Capture lower-intensity chewing patterns.",
  "purpose": "Capture subtle chewing with soft foods.",
  "request": {
    "source": "seed",
    "summary": "Soft foods produce smaller jaw and head motion that may be missed."
  },
  "priority": "medium",
  "required": false,
  "target_recordings": 3,
  "preparation": [
    "Wear both AirPods and confirm they are connected to this iPhone.",
    "Prop the iPhone so your face and jaw are visible.",
    "Use steady, even lighting on your face.",
    "Stay within the camera view for the whole recording.",
    "Prepare a banana or similar soft food."
  ],
  "equipment": [
    "AirPods",
    "iPhone stand"
  ],
  "food": {
    "kind": "food",
    "recommended": "Banana or similar",
    "category": "soft"
  },
  "camera": {
    "position": "Prop the iPhone upright at face height, about an arm's length away, front camera facing you with face and jaw visible."
  },
  "activities": [
    {
      "id": "nod-start",
      "kind": "sync_marker",
      "instruction": "Look at the camera and nod distinctly",
      "duration_s": 5,
      "expected_behavior": "One clear nod visible in video and AirPods motion; mouth still",
      "intended_label": "not_chewing",
      "sync_marker": true,
      "on_quality_loss": "repeat",
      "min_valid_fraction": 0.9
    },
    {
      "id": "still-1",
      "kind": "rest",
      "instruction": "Sit still without chewing",
      "duration_s": 10,
      "expected_behavior": "Seated, jaw still",
      "intended_label": "not_chewing"
    },
    {
      "id": "chew-1",
      "kind": "chew",
      "instruction": "Take a bite and chew normally",
      "duration_s": 25,
      "expected_behavior": "Soft-food chewing, mouth visible",
      "intended_label": "chewing"
    },
    {
      "id": "stop-1",
      "kind": "stop_chewing",
      "instruction": "Finish and stop chewing",
      "duration_s": 10,
      "expected_behavior": "Swallow and keep still",
      "intended_label": "not_chewing"
    },
    {
      "id": "chew-2",
      "kind": "chew",
      "instruction": "Take another bite and chew",
      "duration_s": 25,
      "expected_behavior": "Soft-food chewing",
      "intended_label": "chewing"
    },
    {
      "id": "nod-end",
      "kind": "sync_marker",
      "instruction": "Perform a final nod",
      "duration_s": 5,
      "expected_behavior": "One clear nod visible in video and AirPods motion; mouth still",
      "intended_label": "not_chewing",
      "sync_marker": true,
      "on_quality_loss": "repeat",
      "min_valid_fraction": 0.9
    }
  ],
  "evaluation_purpose": [
    "training",
    "evaluation"
  ],
  "tags": {
    "activity": [
      "chewing"
    ],
    "food_category": [
      "soft"
    ]
  },
  "estimated_minutes": 2.3
}
